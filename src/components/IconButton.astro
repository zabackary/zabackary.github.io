---
import { cookiePath } from "../cookie";
import Ripple from "./Ripple.astro";

interface Props {
  href: string;
  /** Icons have no text, so say what the button does. */
  label: string;
  /** Not a link: stays focusable (aria-disabled, not disabled) so a sibling `Tooltip` can say why. */
  disabled?: boolean;
  /** Slot: an `<svg aria-hidden>` icon, filled with currentColor. Defaults to an arrow. */
}

const { href, label, disabled } = Astro.props;

const Tag = disabled ? "button" : "a";

---

<Tag
  class="icon-button"
  class:list={{ disabled }}
  href={disabled ? undefined : href}
  type={disabled ? "button" : undefined}
  aria-disabled={disabled ? "true" : undefined}
  aria-label={label}
>
  <svg class="cookie" viewBox="-1 -1 2 2" aria-hidden="true"><path d={cookiePath} /></svg>
  {!disabled && <Ripple />}
  <span class="icon">
    <slot>
      {/* Material Symbols "arrow_forward" */}
      <svg viewBox="0 -960 960 960" aria-hidden="true">
        <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
      </svg>
    </slot>
  </span>
</Tag>

<style>
  .icon-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    color: var(--md-on-surface);
    -webkit-tap-highlight-color: transparent;
  }
  .cookie {
    position: absolute;
    inset: 0;
    fill: var(--md-surface-container-high);
    transition: transform 0.5s var(--spring-fast);
  }
  .icon {
    position: relative;
    display: grid;
    width: 1.5rem;
  }
  .icon :global(svg) {
    fill: currentColor;
  }
  button.icon-button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }
  .icon-button:active:not(.disabled) .cookie {
    transform: scale(0.92);
  }
  /* The cookie turns one lobe on hover */
  @media (hover: hover) {
    .icon-button:hover:not(.disabled) .cookie {
      transform: rotate(40deg);
    }
  }
  /* Dimmed and inert: no ripple, no press or hover motion */
  .disabled {
    cursor: not-allowed;
  }
  .disabled .cookie,
  .disabled .icon {
    opacity: 0.45;
  }
</style>
