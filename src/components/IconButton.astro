---
import Ripple from "./Ripple.astro";

interface Props {
  href: string;
  /** Icons have no text, so say what the button does. */
  label: string;
}

const { href, label } = Astro.props;

// A 9-lobed cookie: a circle whose radius wobbles nine times around
const cookie =
  "M" +
  Array.from({ length: 180 }, (_, i) => {
    const angle = (i / 180) * 2 * Math.PI;
    const radius = 0.9 + 0.1 * Math.cos(9 * angle);
    return `${(radius * Math.cos(angle)).toFixed(3)} ${(radius * Math.sin(angle)).toFixed(3)}`;
  }).join("L") +
  "Z";
---

<a class="icon-button" {href} aria-label={label}>
  <svg class="cookie" viewBox="-1 -1 2 2" aria-hidden="true"><path d={cookie} /></svg>
  <Ripple />
  <!-- Material Symbols "arrow_forward" -->
  <svg class="icon" viewBox="0 -960 960 960" aria-hidden="true">
    <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z" />
  </svg>
</a>

<style>
  .icon-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    color: var(--md-on-surface);
    -webkit-tap-highlight-color: transparent;
  }
  .cookie {
    position: absolute;
    inset: 0;
    fill: var(--md-surface-container-high);
    transition: transform 0.5s var(--spring-fast);
  }
  .icon {
    position: relative;
    width: 1.5rem;
    fill: currentColor;
  }
  /* The cookie turns one lobe on hover */
  @media (hover: hover) {
    .icon-button:hover .cookie {
      transform: rotate(40deg);
    }
  }
</style>
