---
import AccountCard from "./AccountCard.astro";
import SectionHeader from "./SectionHeader.astro";

const explanationProse = `You can find me on these platforms. I have more accounts, but for privacy
reasons I'm not disclosing them here. I haven't been active on
Scratch for the past 4 years or so but I include it here for completeness
purposes.`;
---

<section>
  <p class="explanation desktop">{explanationProse}</p>
  <ul>
    <li>
      <AccountCard
        tone="secondary"
        href="https://github.com/zabackary"
        name="GitHub"
        handle="@zabackary"
      >
        {/* Octicons "mark-github" */}
        <svg slot="logo" viewBox="0 0 16 16">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </AccountCard>
    </li>
    <li>
      <AccountCard
        tone="secondary"
        href="https://scratch.mit.edu/users/ZZC12345/"
        name="Scratch"
        handle="@ZZC12345"
      >
        {/* TODO: placeholder cat head, swap for the official Scratch mark */}
        <svg slot="logo" viewBox="0 0 24 24">
          <path
            d="M3 2l5 4h8l5-4v10c0 5-4 9-9 9s-9-4-9-9zM8.5 11a1.5 1.5 0 100 3 1.5 1.5 0 000-3zm7 0a1.5 1.5 0 100 3 1.5 1.5 0 000-3z"
            fill-rule="evenodd"
          />
        </svg>
      </AccountCard>
    </li>
  </ul>
  <SectionHeader align="right">
    Online
    <br />
    accounts
  </SectionHeader>
</section>
<p class="explanation mobile">{explanationProse}</p>

<style>
  section {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    width: fit-content;
  }
  li {
    display: grid;
  }
  .explanation {
    flex: 1 1 100%;
    font-size: 0.875rem;
    color: var(--md-on-surface-variant);
    text-wrap: balance;
    font-style: italic;

    &.desktop {
      text-align: right;
      margin-right: 0.5rem;
      align-self: center;
      max-width: 20rem;
    }
    &.mobile {
      text-align: center;
      margin: 1em auto;
      display: none;
    }
  }

  @media (max-width: 600px) {
    .explanation.desktop {
      display: none;
    }
    .explanation.mobile {
      display: block;
    }
  }
</style>
