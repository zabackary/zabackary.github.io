---
import type { CollectionEntry } from "astro:content";
import IconButton from "./IconButton.astro";
import ProjectCard from "./ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<ul>
  <li class="label">
    <slot name="label" />
  </li>
  {projects.map((project) => (
    <li>
      <ProjectCard {project} compact />
    </li>
  ))}
  <li class="more">
    <IconButton href="/projects" label="More projects" />
  </li>
</ul>

<style>
  ul {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    /* Room for the card's hover lift and focus ring, which the scroller would otherwise clip */
    padding: 0.75rem 0.5rem;
    margin-inline: -0.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.5rem;
    list-style: none;
    scrollbar-width: none;
  }
  li {
    display: grid;
    flex: 0 0 11rem;
    scroll-snap-align: start;
  }
  .label {
    flex: 0 0 auto;
    align-content: center;
    padding-inline: 0.5rem 1rem;

    font-weight: 800;
    font-size: 2.5rem;
    text-align: center;
    font-variation-settings: "wdth" 350;

    color: var(--md-on-surface-variant);
    text-decoration: underline;
    text-decoration-thickness: 0.15em;
    text-underline-offset: -0.15em;
    text-decoration-color: var(--md-surface-container-highest);

    writing-mode: vertical-rl;
    transform: rotate(180deg);
    line-height: 0.8;
    margin-right: 0.5rem;
  }
  .more {
    flex: 0 0 auto;
    align-content: center;
    padding-inline: 0.5rem 1rem;
  }
</style>
