---
import type { Tone } from "../types";

interface Props {
  tone?: Tone;
  /** Shared view-transition name; pairs this hero with a card of the same name on the previous page. */
  transitionName?: string;
}

const { tone = "primary", transitionName } = Astro.props;
---

<section
  class="hero"
  data-tone={tone}
  style={
    transitionName &&
    `view-transition-name: ${transitionName}; view-transition-class: shared`
  }
>
  <div class="text">
    <slot />
  </div>
  <slot name="aside" />
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border-radius: 3rem;
    background: var(--bg);
    color: var(--fg);
  }
  .text {
    max-width: 100%;
  }
</style>
