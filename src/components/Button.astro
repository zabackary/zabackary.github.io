---
import Ripple from "./Ripple.astro";

interface Props {
  href?: string;
  variant?: "filled" | "tonal";
  [attr: `data-${string}`]: string | boolean;
}

const { href, variant = "filled", ...attrs } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag class:list={["button", variant]} href={href} {...attrs}>
  <Ripple />
  <slot />
</Tag>

<style>
  /* Pill at rest, squarer on hover and press */
  .button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    padding: 0.9rem 1.75rem;
    border: 0;
    border-radius: 1.5rem;
    font: 600 1rem var(--font);
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-radius 0.35s var(--spring-fast),
      transform 0.35s var(--spring-fast);
  }
  @media (hover: hover) {
    .button:hover {
      border-radius: 1.25rem;
    }
  }
  .button:active {
    border-radius: 0.5rem;
  }

  .filled {
    background: var(--md-primary);
    color: var(--md-on-primary);
  }
  .tonal {
    background: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
  }
</style>
