---
import { Image } from "astro:assets";
import { containerStyle } from "../theme";
import type { Tone } from "../types";
import Ripple from "./Ripple.astro";

interface Props {
  /** Artwork faded in behind the content: along the top, or down the right side when `calm`. */
  thumbnail?: ImageMetadata;
  tone?: Tone;
  /** Hex colour for the card; overrides `tone`. */
  color?: string;
  /** Makes the card a link. Otherwise it's a plain section. */
  href?: string;
  /** Shared view-transition name; pairs this card with an element of the same name on the next page. */
  transitionName?: string;
  /** Neutral surface colour, and no corner morph (hover tints). */
  calm?: boolean;
}

const { thumbnail, tone = "primary", color, href, transitionName, calm } = Astro.props;
const Tag = href ? "a" : "section";
const style = [
  color && containerStyle(color),
  transitionName &&
    `view-transition-name: ${transitionName}; view-transition-class: shared`,
]
  .filter(Boolean)
  .join(";");
---

<Tag
  class:list={["card", { calm }]}
  data-tone={color ? undefined : tone}
  href={href}
  style={style || undefined}
>
  {
    thumbnail && (
      <div class="thumbnail">
        <Image src={thumbnail} alt="" width={960} loading="lazy" />
      </div>
    )
  }
  {href && <Ripple />}
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 2rem;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.2s var(--effects),
      border-radius 0.55s var(--spring-slow);
  }
  /* isolation keeps the thumbnail (z-index -1) above the card's background but below its content */
  .card:has(.thumbnail) {
    isolation: isolate;
  }
  .thumbnail {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 65%;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000 20%, transparent);
  }
  .calm .thumbnail {
    inset: 0 0 0 auto;
    width: 65%;
    height: auto;
    mask-image: linear-gradient(to left, #000 20%, transparent);
  }
  .thumbnail :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The artwork is white shapes on black. Light: flip it and multiply so shapes darken the card.
       Dark: screen so shapes lighten it. Either way the black/white backdrop drops out. */
    filter: invert(1);
    mix-blend-mode: multiply;
    opacity: 0.2;
  }
  @media (prefers-color-scheme: dark) {
    .thumbnail :global(img) {
      filter: none;
      mix-blend-mode: screen;
      opacity: 0.3;
    }
  }
  /* Only links react to hover */
  @media (hover: hover) {
    a.card:not(.calm):hover {
      border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
    }
  }
  /* Keyboard focus gets the same shape morph as hover */
  a.card:not(.calm):focus-visible {
    border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
  }
  /* Touch has no hover, so pressing is where the morph happens */
  a.card:not(.calm):active {
    border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
  }

  /* Calm cards keep their shape and sit on a neutral surface */
  .calm {
    --bg: var(--md-surface-container-high);
    --fg: var(--md-on-surface);
  }
  @media (hover: hover) {
    a.calm:hover {
      background: color-mix(in srgb, var(--md-on-surface) 8%, var(--bg));
    }
  }
</style>
