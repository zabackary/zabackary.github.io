---
import { containerStyle } from "../theme";
import type { Tone } from "../types";
import Ripple from "./Ripple.astro";

interface Props {
  tone?: Tone;
  /** Hex colour for the card; overrides `tone`. */
  color?: string;
  /** Makes the card a link. Otherwise it's a plain section. */
  href?: string;
  /** Shared view-transition name; pairs this card with an element of the same name on the next page. */
  transitionName?: string;
}

const { tone = "primary", color, href, transitionName } = Astro.props;
const Tag = href ? "a" : "section";
const style = [
  color && containerStyle(color),
  transitionName && `view-transition-name: ${transitionName}; view-transition-class: shared`,
]
  .filter(Boolean)
  .join(";");
---

<Tag
  class="card"
  data-tone={color ? undefined : tone}
  href={href}
  style={style || undefined}
>
  {href && <Ripple />}
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 2rem;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-radius 0.55s var(--spring-slow),
      transform 0.55s var(--spring-slow);
  }
  /* Only links react to hover */
  @media (hover: hover) {
    a.card:hover {
      border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
      transform: translateY(-4px);
    }
  }
  /* Keyboard focus gets the same shape morph as hover */
  a.card:focus-visible {
    border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
  }
  /* Touch has no hover, so pressing is where the morph happens */
  a.card:active {
    border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
    transform: scale(0.98);
  }
</style>
