---
import { containerStyle } from "../theme";
import type { Tone } from "../types";
import Ripple from "./Ripple.astro";

interface Props {
  tone?: Tone;
  /** Hex colour for the card; overrides `tone`. */
  color?: string;
  /** Makes the card a link. Otherwise it's a plain section. */
  href?: string;
  /** Shared view-transition name; pairs this card with an element of the same name on the next page. */
  transitionName?: string;
  /** Neutral surface colour, and no corner morph (hover tints, press scales; nothing translates). */
  calm?: boolean;
}

const { tone = "primary", color, href, transitionName, calm } = Astro.props;
const Tag = href ? "a" : "section";
const style = [
  color && containerStyle(color),
  transitionName &&
    `view-transition-name: ${transitionName}; view-transition-class: shared`,
]
  .filter(Boolean)
  .join(";");
---

<Tag
  class:list={["card", { calm }]}
  data-tone={color ? undefined : tone}
  href={href}
  style={style || undefined}
>
  {href && <Ripple />}
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 2rem;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.2s var(--effects),
      border-radius 0.55s var(--spring-slow),
      translate 0.55s var(--spring-slow),
      scale 0.55s var(--spring-slow);
  }
  /* Only links react to hover */
  @media (hover: hover) {
    a.card:not(.calm):hover {
      translate: 0 -4px;
      border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
    }
  }
  /* Keyboard focus gets the same shape morph as hover */
  a.card:not(.calm):focus-visible {
    border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
  }
  /* Touch has no hover, so pressing is where the morph happens */
  a.card:active {
    scale: 0.98;
  }
  a.card:not(.calm):active {
    border-radius: 3.5rem 0.75rem 3.5rem 0.75rem;
  }

  /* Calm cards keep their shape and sit on a neutral surface */
  .calm {
    --bg: var(--md-surface-container-high);
    --fg: var(--md-on-surface);
  }
  @media (hover: hover) {
    a.calm:hover {
      background: color-mix(in srgb, var(--md-on-surface) 8%, var(--bg));
    }
  }
</style>
