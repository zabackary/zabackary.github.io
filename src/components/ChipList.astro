---
import Chip from "./Chip.astro";

interface Props {
  /** Plain strings, or `{ label, href }` for chips that link somewhere. */
  items: (string | { label: string; href: string })[];
}

const { items } = Astro.props;
---

<div class="chips">
  <slot />
  {items.map((item) =>
    typeof item === "string" ? (
      <Chip>{item}</Chip>
    ) : (
      <Chip href={item.href}>{item.label}</Chip>
    ),
  )}
</div>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    /* Otherwise spare height in a stretched card gets shared out between the chip rows */
    align-content: flex-start;
    align-items: flex-start;
    gap: 0.375rem;
  }
</style>
