---
import type { CollectionEntry } from "astro:content";
import Blob from "./Blob.astro";
import Card from "./Card.astro";
import StatusIcon from "./StatusIcon.astro";
import ChipList from "./ChipList.astro";
import { displayName } from "../displayNames";
import defaultThumbnail from "../assets/default-thumb.webp";

interface Props {
  project: CollectionEntry<"projects">;
  /** Just the glyph and name, on a calm card. */
  compact?: boolean;
}

const { project, compact } = Astro.props;
const { name, description, glyph, color, status, tags, thumbnail } = project.data;
---

{/* No view-transition names here: the script in Layout names just the card being navigated to or from */}
<Card
  href={`/projects/${project.id}`}
  color={compact ? undefined : color}
  calm={compact}
  thumbnail={thumbnail ?? defaultThumbnail}
>
  <Blob>{glyph}</Blob>
  <h3>{name}</h3>
  {!compact && <p>{description}</p>}
  {
    !compact && (
      <ChipList items={tags.map((tag) => displayName(tag, "tag"))}>
        <StatusIcon {status} />
      </ChipList>
    )
  }
</Card>

<style>
  h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }
  p {
    margin: 0;
  }
</style>
