---
import type { CollectionEntry } from "astro:content";
import Blob from "./Blob.astro";
import Card from "./Card.astro";
import ChipList from "./ChipList.astro";
import { projectTransitions } from "../transitions";

interface Props {
  project: CollectionEntry<"projects">;
  /** Just the glyph and name, in the calmer primary tone. */
  compact?: boolean;
}

const { project, compact } = Astro.props;
const { name, description, glyph, color, status, tags } = project.data;
const names = projectTransitions(project.id);
---

<Card
  href={`/projects/${project.id}`}
  color={compact ? undefined : color}
  calm={compact}
  transitionName={names.container}
>
  <Blob transitionName={names.blob}>{glyph}</Blob>
  <h3>{name}</h3>
  {!compact && <p>{description}</p>}
  {!compact && <ChipList items={[status, ...tags]} />}
</Card>

<style>
  h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }
  p {
    margin: 0;
  }
</style>
