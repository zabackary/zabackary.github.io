---
import type { CollectionEntry } from "astro:content";
import Blob from "./Blob.astro";
import Card from "./Card.astro";
import ChipList from "./ChipList.astro";
import { projectTransitions } from "../transitions";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, description, glyph, color, status, tags } = project.data;
const names = projectTransitions(project.id);
---

<Card href={`/projects/${project.id}`} {color} transitionName={names.container}>
  <Blob transitionName={names.blob}>{glyph}</Blob>
  <h3>{name}</h3>
  <p>{description}</p>
  <ChipList items={[status, ...tags]} />
</Card>

<style>
  h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }
  p {
    margin: 0;
  }
</style>
