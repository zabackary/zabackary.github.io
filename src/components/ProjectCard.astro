---
import type { CollectionEntry } from "astro:content";
import Blob from "./Blob.astro";
import Card from "./Card.astro";
import Chip from "./Chip.astro";
import ChipList from "./ChipList.astro";
import { displayName } from "../displayNames";
import defaultThumbnail from "../assets/default-thumb.webp";
import { projectTransitions } from "../transitions";

interface Props {
  project: CollectionEntry<"projects">;
  /** Just the glyph and name, on a calm card. */
  compact?: boolean;
}

const { project, compact } = Astro.props;
const { name, description, glyph, color, status, tags, thumbnail } = project.data;
const names = projectTransitions(project.id);
const statusLabels = {
  finished: "Finished",
  wip: "Work in progress",
  incomplete: "Incomplete",
};
---

<Card
  href={`/projects/${project.id}`}
  color={compact ? undefined : color}
  calm={compact}
  thumbnail={thumbnail ?? defaultThumbnail}
  transitionName={names.container}
>
  <Blob transitionName={names.blob}>{glyph}</Blob>
  <h3>{name}</h3>
  {!compact && <p>{description}</p>}
  {
    !compact && (
      <ChipList items={tags.map((tag) => displayName(tag, "tag"))}>
        <Chip>
          <svg
            class="status"
            viewBox="0 0 24 24"
            role="img"
            aria-label={statusLabels[status]}
          >
            <title>{statusLabels[status]}</title>
            {status === "finished" && <path d="M5 12.5l4.5 4.5L19 7.5" />}
            {status === "wip" && (
              <>
                <circle cx="12" cy="12" r="9" />
                <path class="fill" d="M12 3a9 9 0 0 1 0 18z" />
              </>
            )}
            {status === "incomplete" && <circle cx="12" cy="12" r="9" stroke-dasharray="3.5 3.5" />}
          </svg>
        </Chip>
      </ChipList>
    )
  }
</Card>

<style>
  h3 {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.1;
  }
  p {
    margin: 0;
  }
  .status {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0 -0.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .status .fill {
    fill: currentColor;
  }
</style>
