---
import type { CollectionEntry } from "astro:content";
import { displayName } from "../displayNames";
import Button from "./Button.astro";
import ProjectCard from "./ProjectCard.astro";
import Ripple from "./Ripple.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;

// Shortcuts to the filters most worth reaching for
const featuredTags = ["embedded", "web", "community"];
const featuredLanguages = ["rust", "typescript"];

const sortOptions = [
  { value: "newest", label: "Newest" },
  { value: "oldest", label: "Oldest" },
  { value: "name", label: "Name A–Z" },
  { value: "name-desc", label: "Name Z–A" },
];

const sortDate = ({ data }: CollectionEntry<"projects">) =>
  data.endDate ?? data.startDate ?? "";
const known = {
  tags: [...new Set(projects.flatMap((p) => p.data.tags))],
  languages: [...new Set(projects.flatMap((p) => p.data.languages))],
};

// Display names for the script, keyed like its state: "tag" and "lang"
const names = {
  tag: Object.fromEntries(
    [...new Set([...known.tags, ...featuredTags])].map((n) => [n, displayName(n, "tag")]),
  ),
  lang: Object.fromEntries(
    [...new Set([...known.languages, ...featuredLanguages])].map((n) => [n, displayName(n)]),
  ),
};

// Material Symbols paths, 960 viewBox
const icons = {
  tag: "M856-390 570-104q-12 12-27 18t-30 6q-15 0-30-6t-27-18L103-457q-11-11-17-25.500T80-513v-287q0-33 23.500-56.500T160-880h287q16 0 31 6.500t26 17.500l352 353q12 12 17.500 27t5.500 30q0 15-5.500 29.500T856-390ZM513-160l286-286-353-354H160v286l353 354ZM260-640q25 0 42.500-17.500T320-700q0-25-17.500-42.500T260-760q-25 0-42.500 17.500T200-700q0 25 17.500 42.500T260-640Z",
  globe:
    "M480-80q-82 0-155-31.500t-127.500-86Q143-252 111.500-325T80-480q0-83 31.500-155.500t86-127Q252-817 325-848.500T480-880q83 0 155.500 31.500t127 86q54.500 54.500 86 127T880-480q0 82-31.500 155t-86 127.500q-54.500 54.500-127 86T480-80Zm0-82q26-36 45-75t31-83H404q12 44 31 83t45 75Zm-104-16q-18-33-31.500-68.500T322-320H204q29 50 72.500 87t99.500 55Zm208 0q56-18 99.500-55t72.500-87H638q-9 38-22.500 73.500T584-178ZM170-400h136q-3-20-4.500-39.500T300-480q0-21 1.500-40.500T306-560H170q-5 20-7.500 39.500T160-480q0 21 2.500 40.500T170-400Zm216 0h188q3-20 4.500-39.500T580-480q0-21-1.500-40.500T574-560H386q-3 20-4.500 39.500T380-480q0 21 1.500 40.500T386-400Zm268 0h136q5-20 7.500-39.500T800-480q0-21-2.500-40.500T790-560H654q3 20 4.500 39.500T660-480q0 21-1.500 40.500T654-400Zm-16-240h118q-29-50-72.500-87T584-782q18 33 31.500 68.500T638-640Zm-234 0h152q-12-44-31-83t-45-75q-26 36-45 75t-31 83Zm-200 0h118q9-38 22.500-73.500T376-782q-56 18-99.500 55T204-640Z",
  search:
    "M784-120 532-372q-30 24-69 38t-83 14q-109 0-184.500-75.500T120-580q0-109 75.500-184.500T380-840q109 0 184.500 75.500T640-580q0 44-14 83t-38 69l252 252-56 56ZM380-400q75 0 127.500-52.500T560-580q0-75-52.500-127.500T380-760q-75 0-127.500 52.500T200-580q0 75 52.500 127.500T380-400Z",
  close:
    "m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z",
  sort: "M120-240v-80h240v80H120Zm0-200v-80h480v80H120Zm0-200v-80h720v80H120Z",
};
---

{/* Shown by the script below; without JS the controls would do nothing */}
<search class="bar" hidden data-known={JSON.stringify(known)}>
    <div class="search">
      <div class="field">
        <svg class="leading" viewBox="0 -960 960 960" aria-hidden="true">
          <path d={icons.search}></path>
        </svg>
        <ul class="tokens"></ul>
        <input
          type="text"
          class="input"
          role="combobox"
          aria-label="Search projects, tags and languages"
          aria-controls="suggestions"
          aria-expanded="false"
          aria-autocomplete="list"
          placeholder="Search, or add a tag or language"
          enterkeyhint="search"
          autocomplete="off"
          spellcheck="false"
        />
        <button type="button" class="clear" aria-label="Clear filters" hidden>
          <Ripple />
          <svg viewBox="0 -960 960 960" aria-hidden="true"><path d={icons.close}></path></svg>
        </button>
      </div>
      <ul class="menu suggestions" id="suggestions" role="listbox" aria-label="Suggestions" hidden></ul>
    </div>

    <div class="sort">
      <button
        type="button"
        class="sort-button"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label="Sort projects"
      >
        <Ripple />
        <svg viewBox="0 -960 960 960" aria-hidden="true"><path d={icons.sort}></path></svg>
      </button>
      <div class="menu" role="menu" aria-label="Sort by" hidden>
        {sortOptions.map(({ value, label }) => (
          <button type="button" role="menuitemradio" data-sort={value} aria-checked="false">
            <Ripple />
            {label}
          </button>
        ))}
      </div>
    </div>
</search>

<ul class="quick" hidden aria-label="Quick filters">
  {featuredTags.map((tag) => (
    <li>
      <button type="button" class="toggle" data-kind="tag" data-value={tag} aria-pressed="false">
        <Ripple />
        <svg viewBox="0 -960 960 960" aria-hidden="true"><path d={icons.tag}></path></svg>
        {displayName(tag, "tag")}
      </button>
    </li>
  ))}
  {featuredLanguages.map((language) => (
    <li>
      <button type="button" class="toggle" data-kind="lang" data-value={language} aria-pressed="false">
        <Ripple />
        <svg viewBox="0 -960 960 960" aria-hidden="true"><path d={icons.globe}></path></svg>
        {displayName(language)}
      </button>
    </li>
  ))}
</ul>

<p class="count" role="status"></p>

<ul class="grid projects">
  {projects.map((project) => (
    <li
      data-name={project.data.name.toLowerCase()}
      data-text={`${project.data.name} ${project.data.description}`.toLowerCase()}
      data-date={sortDate(project)}
      data-tags={project.data.tags.join(",")}
      data-langs={project.data.languages.join(",")}
    >
      <ProjectCard {project} />
    </li>
  ))}
</ul>

<div class="empty" hidden>
  <svg class="art" viewBox="0 0 200 160" aria-hidden="true">
    <path
      class="blob"
      d="M34 82c-8-32 16-62 54-66s74 10 86 40-2 66-40 80-82 8-98-18c-5-9-5-24-2-36z"
    ></path>
    <g transform="rotate(-8 88 84)">
      <rect class="page" x="50" y="36" width="76" height="92" rx="14"></rect>
      <rect class="line" x="64" y="54" width="44" height="8" rx="4"></rect>
      <rect class="line" x="64" y="72" width="32" height="8" rx="4"></rect>
      <rect class="line" x="64" y="90" width="40" height="8" rx="4"></rect>
    </g>
    <circle class="lens" cx="124" cy="94" r="27"></circle>
    <path class="handle" d="M144 114 168 138"></path>
    <path class="face" d="M111 96q6.5-9 13 0t13 0"></path>
    <path
      class="spark a"
      transform="translate(34 40)"
      d="M0-12C1-4 4-1 12 0 4 1 1 4 0 12-1 4-4 1-12 0-4-1-1-4 0-12Z"
    ></path>
    <path
      class="spark b"
      transform="translate(174 36) scale(.7)"
      d="M0-12C1-4 4-1 12 0 4 1 1 4 0 12-1 4-4 1-12 0-4-1-1-4 0-12Z"
    ></path>
    <path
      class="spark b"
      transform="translate(26 124) scale(.55)"
      d="M0-12C1-4 4-1 12 0 4 1 1 4 0 12-1 4-4 1-12 0-4-1-1-4 0-12Z"
    ></path>
  </svg>
  <p>No projects match those filters.</p>
  <Button variant="tonal" data-reset>Clear filters</Button>
</div>

<template id="token-template">
  <li>
    <button type="button" class="token">
      <Ripple />
      <svg class="kind" viewBox="0 -960 960 960" aria-hidden="true"><path></path></svg>
      <span></span>
      <span class="x" aria-hidden="true">
        <svg viewBox="0 -960 960 960"><path d={icons.close}></path></svg>
      </span>
    </button>
  </li>
</template>

<script define:vars={{ icons, names }}>
  const root = document.querySelector(".bar");
  const quick = document.querySelector(".quick");
  const input = root.querySelector(".input");
  const field = root.querySelector(".field");
  const tokenList = root.querySelector(".tokens");
  const suggestionList = root.querySelector(".suggestions");
  const clear = root.querySelector(".clear");
  const sortButton = root.querySelector(".sort-button");
  // Not just ".menu": the suggestions popup shares that class
  const menu = root.querySelector(".sort .menu");
  const toggles = [...quick.querySelectorAll(".toggle")];
  const grid = document.querySelector(".projects");
  const items = [...grid.children];
  const count = document.querySelector(".count");
  const empty = document.querySelector(".empty");
  const template = document.getElementById("token-template");
  const known = JSON.parse(root.dataset.known);

  const sorts = {
    newest: (a, b) => b.dataset.date.localeCompare(a.dataset.date),
    oldest: (a, b) => (a.dataset.date || "~").localeCompare(b.dataset.date || "~"),
    name: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
    "name-desc": (a, b) => b.dataset.name.localeCompare(a.dataset.name),
  };

  // The URL is the source of truth: ?q=text&tag=web&tag=cli&lang=rust&sort=name
  const state = { q: "", tag: [], lang: [], sort: "newest" };

  const read = () => {
    const params = new URLSearchParams(location.search);
    state.q = params.get("q") ?? "";
    state.tag = [...new Set(params.getAll("tag"))];
    state.lang = [...new Set(params.getAll("lang"))];
    state.sort = Object.hasOwn(sorts, params.get("sort")) ? params.get("sort") : "newest";
  };

  const write = () => {
    const params = new URLSearchParams();
    if (state.q) params.set("q", state.q);
    state.tag.forEach((t) => params.append("tag", t));
    state.lang.forEach((l) => params.append("lang", l));
    if (state.sort !== "newest") params.set("sort", state.sort);
    const query = params.toString();
    history.replaceState(null, "", location.pathname + (query ? "?" + query : "") + location.hash);
  };

  const labelFor = (kind, value) => names[kind][value] ?? value;

  // Only tokens that weren't there last time pop in
  let shownTokens = null; // null on first render, so tokens from the URL don't pop
  const renderTokens = () => {
    tokenList.replaceChildren();
    const now = new Set();
    for (const [kind, icon] of [["tag", icons.tag], ["lang", icons.globe]]) {
      for (const value of state[kind]) {
        const item = template.content.firstElementChild.cloneNode(true);
        // The whole chip is the remove button
        const token = item.querySelector(".token");
        token.dataset.kind = kind;
        now.add(kind + value);
        if (shownTokens && !shownTokens.has(kind + value)) token.classList.add("added");
        token.querySelector(".kind path").setAttribute("d", icon);
        token.querySelector("span").textContent = labelFor(kind, value);
        token.setAttribute("aria-label", `Remove ${kind === "tag" ? "tag" : "language"} ${labelFor(kind, value)}`);
        token.addEventListener("click", () => {
          state[kind] = state[kind].filter((v) => v !== value);
          update();
          input.focus();
        });
        tokenList.append(item);
      }
    }
    shownTokens = now;
  };

  const apply = () => {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const tags = item.dataset.tags.split(",");
      const langs = item.dataset.langs.split(",");
      const match =
        state.tag.every((t) => tags.includes(t)) &&
        state.lang.every((l) => langs.includes(l)) &&
        words.every((w) => item.dataset.text.includes(w));
      item.hidden = !match;
      if (match) shown++;
    }
    // Reorder the DOM (not CSS `order`) so tab order matches what's on screen
    grid.append(...[...items].sort(sorts[state.sort]));
    empty.hidden = shown > 0;
    count.textContent = shown ? `${shown} ${shown === 1 ? "project" : "projects"}` : "";
  };

  const update = () => {
    renderTokens();
    for (const toggle of toggles) {
      toggle.setAttribute("aria-pressed", String(state[toggle.dataset.kind].includes(toggle.dataset.value)));
    }
    for (const option of menu.querySelectorAll("[data-sort]")) {
      option.setAttribute("aria-checked", String(option.dataset.sort === state.sort));
    }
    clear.hidden = !(state.q || state.tag.length || state.lang.length);
    apply();
    write();
  };

  const toggleValue = (kind, value) => {
    const list = state[kind];
    state[kind] = list.includes(value) ? list.filter((v) => v !== value) : [...list, value];
  };

  // "tag:web" / "lang:rust", or a bare word that exactly names a known tag, then a known language
  const resolve = (text) => {
    const [, prefix, rest] = text.toLowerCase().match(/^(?:(tag|lang):)?(.*)$/);
    const word = rest.trim();
    const matches = (kind, list) =>
      list.find((v) => v === word || labelFor(kind, v).toLowerCase() === word) && { kind, value: list.find((v) => v === word || labelFor(kind, v).toLowerCase() === word) };
    if (prefix === "tag") return matches("tag", known.tags);
    if (prefix === "lang") return matches("lang", known.languages);
    return matches("tag", known.tags) || matches("lang", known.languages);
  };

  const commitInput = () => {
    const token = resolve(input.value.trim());
    if (!token) return false;
    if (!state[token.kind].includes(token.value)) state[token.kind].push(token.value);
    input.value = "";
    state.q = "";
    return true;
  };

  // Suggestions: unselected tags and languages whose name contains the typed text, prefix matches first
  let suggestions = [];
  let active = -1;
  const showSuggestions = () => {
    const text = input.value.trim().toLowerCase().replace(/^(tag|lang):/, "");
    const prefix = input.value.trim().toLowerCase().match(/^(tag|lang):/)?.[1];
    suggestions = [];
    if (text || prefix) {
      for (const [kind, list] of [["tag", known.tags], ["lang", known.languages]]) {
        if (prefix && prefix !== kind) continue;
        for (const value of list) {
          const label = labelFor(kind, value).toLowerCase();
          if (state[kind].includes(value) || !(label.includes(text) || value.includes(text))) continue;
          suggestions.push({ kind, value, rank: label.startsWith(text) ? 0 : 1 });
        }
      }
      suggestions.sort((a, b) => a.rank - b.rank).splice(6);
    }
    active = -1;
    suggestionList.replaceChildren(
      ...suggestions.map(({ kind, value }, i) => {
        const option = document.createElement("li");
        option.id = `suggestion-${i}`;
        option.setAttribute("role", "option");
        option.dataset.kind = kind;
        option.innerHTML = `<svg viewBox="0 -960 960 960" aria-hidden="true"><path d="${kind === "tag" ? icons.tag : icons.globe}"></path></svg>`;
        option.append(labelFor(kind, value));
        // mousedown, not click, so the input keeps focus
        option.addEventListener("mousedown", (event) => {
          event.preventDefault();
          pick(i);
        });
        return option;
      }),
    );
    suggestionList.hidden = suggestions.length === 0;
    input.setAttribute("aria-expanded", String(suggestions.length > 0));
    input.removeAttribute("aria-activedescendant");
  };
  const setActive = (i) => {
    active = i;
    [...suggestionList.children].forEach((option, j) => option.setAttribute("aria-selected", String(j === i)));
    if (i >= 0) input.setAttribute("aria-activedescendant", `suggestion-${i}`);
    else input.removeAttribute("aria-activedescendant");
  };
  const pick = (i) => {
    const { kind, value } = suggestions[i];
    state[kind].push(value);
    input.value = "";
    state.q = "";
    update();
    showSuggestions();
  };

  input.addEventListener("input", () => {
    state.q = input.value.trim();
    update();
    showSuggestions();
  });
  const closeSuggestions = () => {
    suggestions = [];
    suggestionList.hidden = true;
    input.setAttribute("aria-expanded", "false");
    input.removeAttribute("aria-activedescendant");
  };
  input.addEventListener("blur", closeSuggestions);
  input.addEventListener("keydown", (event) => {
    if (suggestions.length && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
      event.preventDefault();
      const step = event.key === "ArrowDown" ? 1 : -1;
      // Cycles through the options and a "none" slot (-1), so Enter can still run plain text
      const slots = suggestions.length + 1;
      setActive(((active + 1 + step + slots) % slots) - 1);
    } else if (event.key === "Escape" && suggestions.length) {
      closeSuggestions();
    } else if (event.key === "Enter") {
      event.preventDefault();
      if (active >= 0) pick(active);
      else if (commitInput()) update();
    } else if (event.key === "Backspace" && !input.value) {
      // Like most token fields: backspace on an empty input removes the last token
      const kind = state.lang.length ? "lang" : "tag";
      if (state[kind].length) {
        state[kind].pop();
        update();
      }
    }
  });
  field.addEventListener("click", (event) => {
    if (event.target === field || event.target === tokenList) input.focus();
  });
  toggles.forEach((toggle) =>
    toggle.addEventListener("click", () => {
      toggleValue(toggle.dataset.kind, toggle.dataset.value);
      update();
    }),
  );
  const resetFilters = () => {
    state.q = "";
    state.tag = [];
    state.lang = [];
    input.value = "";
    update();
    input.focus();
  };
  clear.addEventListener("click", resetFilters);
  empty.querySelector("[data-reset]").addEventListener("click", resetFilters);

  const setMenu = (open) => {
    menu.hidden = !open;
    sortButton.setAttribute("aria-expanded", String(open));
  };
  sortButton.addEventListener("click", () => {
    setMenu(menu.hidden);
    if (!menu.hidden) menu.querySelector('[aria-checked="true"]').focus();
  });
  menu.addEventListener("click", (event) => {
    const option = event.target.closest("[data-sort]");
    if (!option) return;
    state.sort = option.dataset.sort;
    setMenu(false);
    sortButton.focus();
    update();
  });
  menu.addEventListener("keydown", (event) => {
    const options = [...menu.querySelectorAll("[data-sort]")];
    const i = options.indexOf(document.activeElement);
    if (event.key === "ArrowDown") options[(i + 1) % options.length].focus();
    else if (event.key === "ArrowUp") options[(i - 1 + options.length) % options.length].focus();
    else if (event.key === "Escape" || event.key === "Tab") {
      setMenu(false);
      if (event.key === "Escape") sortButton.focus();
    } else return;
    if (event.key !== "Tab") event.preventDefault();
  });
  document.addEventListener("click", (event) => {
    if (!menu.hidden && !event.target.closest(".sort")) setMenu(false);
  });

  read();
  input.value = state.q;
  root.hidden = false;
  quick.hidden = false;
  update();
</script>

<style>
  /* Sticks just under the nav pill; no backdrop, the bar and button contrast enough on their own */
  .bar {
    position: sticky;
    top: 5rem;
    z-index: 5;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
  }
  .bar[hidden] {
    display: none;
  }
  svg {
    fill: currentColor;
  }

  .search {
    position: relative;
    flex: 1 1 14rem;
    max-width: 36rem;
  }
  /* M3 search bar: a full-round tonal pill with a leading search icon and trailing clear */
  .field {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    min-height: 3.5rem;
    padding: 0.5rem 3.25rem 0.5rem 1rem; /* right side leaves room for the clear button */
    border-radius: 1.75rem;
    background: var(--md-surface-container-high);
    color: var(--md-on-surface);
    cursor: text;
    transition:
      border-radius 0.45s var(--spring-fast),
      background 0.2s var(--effects);
  }
  /* The input has no ring of its own; the whole bar shows the site's focus ring instead */
  .field:has(.input:focus-visible) {
    outline: 3px solid var(--md-primary);
    outline-offset: 3px;
    animation: focus-ring 0.6s var(--effects);
  }
  .field:focus-within {
    border-radius: 1rem;
  }

  @media (hover: hover) {
    .field:hover {
      background: color-mix(in srgb, var(--md-on-surface) 8%, var(--md-surface-container-high));
    }
  }
  .leading {
    flex: none;
    width: 1.5rem;
    color: var(--md-on-surface-variant);
  }
  .input {
    flex: 1;
    min-width: 4rem;
    text-overflow: ellipsis;
    min-height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }
  .input::placeholder {
    color: var(--md-on-surface-variant);
  }
  /* The field shows its own focus state; the global ring would sit around a borderless input */
  .input:focus-visible {
    outline: none;
    animation: none;
  }

  .tokens {
    display: contents;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tokens li {
    display: contents;
  }
  /* Normal chip: 8dp corners, morphing like the link chips on hover and press */
  .token {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--chip-height);
    padding: 0 0.25rem 0 0.5rem;
    border: 0;
    border-radius: var(--chip-radius);
    background: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
    font: 500 0.875rem var(--font);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.2s var(--effects),
      border-radius 0.45s var(--spring-fast);
  }
  .token:active {
    border-radius: 0.9rem;
  }
  @media (pointer: coarse) {
    .token {
      min-height: 2.75rem;
    }
  }
  @media (hover: hover) {
    .token:hover {
      border-radius: 0.9rem;
      background: color-mix(in srgb, var(--md-on-surface) 8%, var(--md-secondary-container));
    }
  }
  /* The × is only a picture; the chip is the button. A true 1:1 circle. */
  .x {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .x svg {
    width: 1rem;
  }
  @media (hover: hover) {
    .token:hover .x {
      background: color-mix(in srgb, currentColor 14%, transparent);
    }
  }
  .token.added {
