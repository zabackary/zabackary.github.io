---
const links = [
  { href: "/", label: "Projects", match: (path: string) => path === "/" || path.startsWith("/projects") },
  { href: "/about", label: "About", match: (path: string) => path.startsWith("/about") },
];
const path = Astro.url.pathname;
---

<nav aria-label="Primary">
  {
    links.map(({ href, label, match }) => (
      <a href={href} aria-current={match(path) ? "page" : undefined}>
        {label}
      </a>
    ))
  }
</nav>

<style>
  nav {
    position: sticky;
    top: 0.75rem;
    z-index: 10;
    display: flex;
    gap: 0.25rem;
    width: fit-content;
    margin: 0 auto 2.5rem;
    padding: 0.375rem;
    border-radius: 999px;
    background: var(--md-surface-container-high);
  }
  a {
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    color: var(--md-on-surface-variant);
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s var(--effects);
  }
  a:hover {
    background: color-mix(in srgb, var(--md-on-surface) 8%, transparent);
  }
  a[aria-current="page"] {
    background: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
  }
</style>
