---
import Ripple from "./Ripple.astro";

const links = [
  { href: "/", label: "About", match: (path: string) => path === "/" },
  {
    href: "/projects",
    label: "Projects",
    match: (path: string) => path.startsWith("/projects"),
  },
];
const path = Astro.url.pathname;
---

<nav aria-label="Primary">
  {links.map(({ href, label, match }) => (
    <a href={href} aria-current={match(path) ? "page" : undefined}>
      <Ripple />
      {label}
    </a>
  ))}
</nav>

<style>
  nav {
    view-transition-name: nav; /* keeps the nav from fading with the page */
    position: sticky;
    top: 1rem; /* matches the body padding so the nav doesn't shift when it sticks */
    z-index: 10;
    display: flex;
    gap: 0.25rem;
    width: fit-content;
    margin: 0 auto 2.5rem;
    padding: 0.375rem;
    border-radius: 999px;
    background: var(--md-surface-container-high);
  }
  a {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    color: var(--md-on-surface-variant);
    font-weight: 600;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.2s var(--effects);
  }
  @media (hover: hover) {
    a:hover {
      background: color-mix(in srgb, var(--md-on-surface) 8%, transparent);
    }
  }
  a:active {
    background: color-mix(in srgb, var(--md-on-surface) 12%, transparent);
  }
  a[aria-current="page"],
  a[aria-current="page"]:active {
    background: var(--md-secondary-container);
    color: var(--md-on-secondary-container);
    view-transition-name: nav-active; /* the pill slides to the next current link */
  }
</style>
