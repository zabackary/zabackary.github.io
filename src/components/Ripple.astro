---
// Put as the first child of a button or link; the parent needs `position: relative`.
---

<ripple-effect aria-hidden="true"></ripple-effect>

<style>
  ripple-effect {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    pointer-events: none;
  }
  /* The canvas is added by the script below, so it isn't scoped */
  ripple-effect :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // Fraction of the circle's radius that is fully opaque
  const SOLID = 0.8;
  const GROW_MS = 450;
  const FADE_MS = 300;
  const SPARKLE_FADE_MS = 400;

  const vertexSource = `
    attribute vec2 aPos;
    void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
  `;

  // A soft circle plus a field of small dots that each twinkle on their own phase
  const fragmentSource = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
    precision highp float;
    #else
    precision mediump float;
    #endif
    uniform vec2 uOrigin;   // CSS px, y down
    uniform float uHeight;  // CSS px
    uniform float uScale;   // device px per CSS px
    uniform float uRadius;  // current circle radius, CSS px
    uniform float uAlpha;
    uniform float uSparkle; // 0-1, sparkles fade out on their own after the circle has grown
    uniform float uTime;    // seconds
    uniform vec3 uColor;

    // Sine-free hash (Dave Hoskins): the usual fract(sin(...)) one gets blocky on some GPUs/drivers
    float hash(vec2 p) {
      vec3 p3 = fract(vec3(p.xyx) * 0.1031);
      p3 += dot(p3, p3.yzx + 33.33);
      return fract((p3.x + p3.y) * p3.z);
    }

    void main() {
      vec2 p = vec2(gl_FragCoord.x, gl_FragCoord.y) / uScale;
      p.y = uHeight - p.y;

      float dist = distance(p, uOrigin);
      float edge = 1.0 - smoothstep(uRadius * ${SOLID.toFixed(2)}, uRadius, dist);

      const float cellSize = 4.0;
      vec2 cell = floor(p / cellSize);
      float isSpark = step(0.93, hash(cell));
      float phase = hash(cell + 7.0) * 6.2832;
      float speed = 2.0 + hash(cell + 3.0) * 5.0;
      // Mostly off, with a brief flash each cycle
      // Subtracting distance from the phase makes the flashes travel outward
      float twinkle = smoothstep(0.5, 1.0, sin(uTime * speed + phase - dist * 0.08));
      // Each dot gets its own position and size inside its cell
      vec2 center = 0.3 + 0.4 * vec2(hash(cell + 11.0), hash(cell + 19.0));
      float size = 0.12 + 0.18 * hash(cell + 23.0);
      float dotShape = 1.0 - smoothstep(size * 0.4, size, length(fract(p / cellSize) - center));
      float spark = isSpark * twinkle * dotShape;

      // Sparkles are strongest near the leading edge, so they look like they radiate out
      float nearEdge = smoothstep(0.0, 0.6, dist / uRadius);
      float a = uAlpha * edge * (0.14 + 0.4 * spark * nearEdge * uSparkle);
      gl_FragColor = vec4(uColor * a, a);
    }
  `;

  // Any CSS colour (including oklch) to 0-1 RGB, by letting a 2d canvas parse it
  function parseColor(css: string): [number, number, number] {
    const ctx = document.createElement("canvas").getContext("2d", { willReadFrequently: true })!;
    ctx.fillStyle = css;
    ctx.fillRect(0, 0, 1, 1);
    const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
    return [r / 255, g / 255, b / 255];
  }

  interface Ripple {
    x: number;
    y: number;
    finalRadius: number;
    startedAt: number;
    released: boolean;
    fadeStartedAt: number | null;
  }

  class RippleEffect extends HTMLElement {
    private canvas?: HTMLCanvasElement;
    private gl?: WebGLRenderingContext;
    private uniforms: Record<string, WebGLUniformLocation | null> = {};
    private color: [number, number, number] = [0, 0, 0];
    private ripple?: Ripple;

    connectedCallback() {
      const parent = this.parentElement;
      if (!parent) return;
      parent.addEventListener("pointerdown", (e) => {
        if (e.button === 0) this.start(e.clientX, e.clientY, parent);
      });
      // Enter/Space on a keyboard-focused element fire a click with no pointer
      parent.addEventListener("click", (e) => {
        if (e.detail === 0) this.start(null, null, parent);
      });
    }

    start(clientX: number | null, clientY: number | null, parent: HTMLElement) {
      if (reducedMotion.matches) return;

      const box = this.getBoundingClientRect();
      const x = clientX === null ? box.width / 2 : clientX - box.left;
      const y = clientY === null ? box.height / 2 : clientY - box.top;
      // Big enough that the opaque core reaches the farthest corner, so the faded rim is never visible
      const reach = Math.hypot(Math.max(x, box.width - x), Math.max(y, box.height - y));

      const ripple: Ripple = {
        x,
        y,
        finalRadius: reach / SOLID,
        startedAt: performance.now(),
        released: clientX === null,
        fadeStartedAt: null,
      };
      if (!this.setUp(box, parent)) return;
      const isRunning = this.ripple !== undefined;
      this.ripple = ripple;
      if (!isRunning) requestAnimationFrame((now) => this.draw(now));

      if (!ripple.released) {
        const events = ["pointerup", "pointercancel", "pointerleave"];
        const done = () => {
          events.forEach((name) => parent.removeEventListener(name, done));
          ripple.released = true;
        };
        events.forEach((name) => parent.addEventListener(name, done));
      }
    }

    // Returns false if WebGL isn't available; the ripple is decoration, so we just skip it
    private setUp(box: DOMRect, parent: HTMLElement) {
      const scale = devicePixelRatio;
      if (!this.canvas) {
        const canvas = document.createElement("canvas");
        const gl = canvas.getContext("webgl", { premultipliedAlpha: true });
        if (!gl) {
          console.warn("ripple: WebGL is unavailable, so no ripple will show");
          return false;
        }

        const program = gl.createProgram()!;
        for (const [type, source] of [
          [gl.VERTEX_SHADER, vertexSource],
          [gl.FRAGMENT_SHADER, fragmentSource],
        ] as const) {
          const shader = gl.createShader(type)!;
          gl.shaderSource(shader, source);
          gl.compileShader(shader);
          gl.attachShader(program, shader);
        }
        gl.linkProgram(program);
        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          console.warn("ripple: shader failed to build", gl.getProgramInfoLog(program));
          return false;
        }
        gl.useProgram(program);

        // One triangle covering the whole canvas
        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        const aPos = gl.getAttribLocation(program, "aPos");
        gl.enableVertexAttribArray(aPos);
        gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

        for (const name of ["uOrigin", "uHeight", "uScale", "uRadius", "uAlpha", "uSparkle", "uTime", "uColor"]) {
          this.uniforms[name] = gl.getUniformLocation(program, name);
        }
        gl.enable(gl.BLEND);
        gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

        this.canvas = canvas;
        this.gl = gl;
        this.append(canvas);
      }
      this.canvas.width = Math.round(box.width * scale);
      this.canvas.height = Math.round(box.height * scale);
      this.gl!.viewport(0, 0, this.canvas.width, this.canvas.height);
      this.color = parseColor(getComputedStyle(parent).color);
      return true;
    }

    private draw(now: number) {
      const { gl, ripple, uniforms } = this;
      if (!gl || !ripple || !this.canvas) return;

      const grown = Math.min((now - ripple.startedAt) / GROW_MS, 1);
      // Ease out: fast start, settles at the corners
      const radius = ripple.finalRadius * (1 - Math.pow(1 - grown, 4));

      let alpha = 1;
      if (grown === 1 && ripple.released) {
        ripple.fadeStartedAt ??= now;
        alpha = 1 - (now - ripple.fadeStartedAt) / FADE_MS;
      }

      if (alpha <= 0) return this.tearDown();

      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform2f(uniforms.uOrigin, ripple.x, ripple.y);
      gl.uniform1f(uniforms.uHeight, this.canvas.height / devicePixelRatio);
      gl.uniform1f(uniforms.uScale, devicePixelRatio);
      gl.uniform1f(uniforms.uRadius, radius);
      gl.uniform1f(uniforms.uAlpha, alpha);
      // Sparkles fade shortly after the circle is fully grown, whether or not the press is held
      const sinceGrown = now - ripple.startedAt - GROW_MS;
      gl.uniform1f(uniforms.uSparkle, 1 - Math.min(Math.max(sinceGrown / SPARKLE_FADE_MS, 0), 1));
      gl.uniform1f(uniforms.uTime, (now - ripple.startedAt) / 1000);
      gl.uniform3f(uniforms.uColor, ...this.color);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      requestAnimationFrame((t) => this.draw(t));
    }

    // Browsers cap live WebGL contexts, so release ours between ripples
    private tearDown() {
      this.gl?.getExtension("WEBGL_lose_context")?.loseContext();
      this.canvas?.remove();
      this.canvas = undefined;
      this.gl = undefined;
      this.ripple = undefined;
    }
  }

  customElements.define("ripple-effect", RippleEffect);
</script>
