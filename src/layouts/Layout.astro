---
import NavBar from "../components/NavBar.astro";
import "../styles/global.css";
import "../styles/transitions.css";

interface Props {
  title?: string;
  /** CSS from `themeCss()`, overriding the colour tokens for this page */
  theme?: string;
}

const { title = "zabackary", theme } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,100..1000&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {theme && <style set:html={theme} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <NavBar />
    <main id="main" tabindex="-1"><slot /></main>
  </body>
</html>
