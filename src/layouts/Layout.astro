---
import NavBar from "../components/NavBar.astro";
import "../styles/global.css";
import "../styles/transitions.css";

interface Props {
  title?: string;
  /** CSS from `themeCss()`, overriding the colour tokens for this page */
  theme?: string;
}

const { title = "zabackary", theme } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="256x256" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wdth,wght@8..144,25..151,100..1000&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/theme.css" />
    <title>{title}</title>
    {theme && <style set:html={theme} />}
    <!-- Inline in <head> so the pagereveal listener exists before the first render -->
    <script is:inline>
      // The card <-> hero morph only names the one project card being navigated to or from. Naming
      // every card up front makes the browser snapshot all of them on each navigation, which gets
      // slow with lots of projects. The detail page's hero and blob carry the same names statically.
      let named = [];
      const pathOf = (url) => new URL(url).pathname.replace(/\/$/, "");
      const unname = () => {
        for (const el of named) {
          el.style.viewTransitionName = "";
          el.style.viewTransitionClass = "";
        }
        named = [];
      };
      const nameCardFor = (url) => {
        // Clear first: a page restored from the back/forward cache still has the old names
        unname();
        const path = pathOf(url);
        // checkVisibility skips the hidden duplicate in RecentProjectsView
        const card = [...document.querySelectorAll("a.card")].find(
          (a) => pathOf(a.href) === path && a.checkVisibility(),
        );
        const blob = card?.querySelector(".blob");
        if (!blob) return;
        card.style.viewTransitionName = "project";
        blob.style.viewTransitionName = "project-blob";
        named = [card, blob];
        for (const el of named) el.style.viewTransitionClass = "shared";
      };

      addEventListener("pageswap", (event) => {
        if (event.viewTransition && event.activation?.entry) nameCardFor(event.activation.entry.url);
      });
      addEventListener("pagereveal", (event) => {
        const from = window.navigation?.activation?.from;
        if (!event.viewTransition || !from) return;
        nameCardFor(from.url);
        event.viewTransition.finished.finally(unname);
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <NavBar />
    <main id="main" tabindex="-1"><slot /></main>
  </body>
</html>
