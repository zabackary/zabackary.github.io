---
import { getCollection } from "astro:content";
import pfp from "../assets/pfp.webp";
import Blob from "../components/Blob.astro";
import Card from "../components/Card.astro";
import HeroCard from "../components/HeroCard.astro";
import RecentProjectsView from "../components/RecentProjectsView.astro";
import Tooltip from "../components/Tooltip.astro";
import Layout from "../layouts/Layout.astro";
import Divider from "../components/Divider.astro";
import OnlineAccounts from "../components/OnlineAccounts.astro";
import Languages from "../components/Languages.astro";
import SectionHeader from "../components/SectionHeader.astro";

// Newest first; undated projects go last
const recent = (await getCollection("projects"))
  .sort((a, b) =>
    (b.data.endDate ?? b.data.startDate ?? "").localeCompare(
      a.data.endDate ?? a.data.startDate ?? "",
    ),
  )
  .slice(0, 3);
---

<Layout title="about zabackary">
  <HeroCard tone="primary">
    <h1 class="display">
      Hi, I'm
      <br />
      zabackary.
    </h1>
    <div slot="aside" class="pfp">
      <button
        type="button"
        aria-label="Profile picture"
        aria-describedby="pfp-tip"
      >
        <Blob size="large">
          <img src={pfp.src} alt="" width="288" height="288" />
        </Blob>
      </button>
      <Tooltip id="pfp-tip">Yes, this is really my profile picture.</Tooltip>
    </div>
  </HeroCard>
  <h2 class="tagline">
    Just a student living in Japan doing embedded, web, and native apps.
  </h2>

  <Divider />

  <RecentProjectsView projects={recent}>
    <Fragment slot="label">
      Recent
      <br />
      projects
    </Fragment>
  </RecentProjectsView>

  <Divider />

  <OnlineAccounts />

  <Divider />

  <SectionHeader align="center">Q&amp;A</SectionHeader>
  <div class="grid">
    <Card tone="secondary">
      <h2 class="headline">Who am I and what do I do?</h2>
      <p>
        I work on embedded systems, web apps, and normal native apps across a
        variety of programming languages and platforms, sometimes working for
        myself but usually in the service of others.
      </p>
    </Card>
    <Card tone="secondary">
      <h2 class="headline">Isn&apos;t this vibe coded?</h2>
      <p>
        Yes, nice catch -- it means your AI literacy is pretty good. This
        website was created in Astro with Claude Code using Sonnset 5, Sonnet
        5.5, and Opus 5.5. All copy was written by me. Yes, I did write that em
        dash.
      </p>
    </Card>
    <Card tone="secondary">
      <h2 class="headline">Any favorite project?</h2>
      <p>
        Not a singular one, but I like{" "}
        <a href="/projects/photo-booth">the photo booth software</a> I&apos;ve
        been working on for over three years and{" "}
        <a href="/projects/daktronics-singular-ui">some scoreboard software</a>{" "}
        for its community impact and bare metal nature.
      </p>
    </Card>
  </div>

  <Divider />

  <SectionHeader align="center">My languages</SectionHeader>
  <Languages />
</Layout>

<style>
  .pfp {
    position: relative;
  }
  .pfp button {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 50%;
    cursor: help;
    -webkit-tap-highlight-color: transparent;
  }
  .grid {
    margin-top: 1rem;

    h2 {
      margin-top: 0;
      margin-bottom: 0;
    }
    p {
      margin-top: 0;
      margin-bottom: 0;
    }
  }
  .tagline {
    max-width: 30rem;
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--md-on-surface-variant);
    text-align: center;
    margin: 1rem auto;
  }
  .tagline::before {
    margin-right: 0.5rem;
    content: "“";
  }
  .tagline::after {
    margin-left: 0.5rem;
    content: "”";
  }
  .tagline::before,
  .tagline::after {
    transform: scale(1.5);
    display: inline-block;
    vertical-align: -0.25em;
    color: var(--md-on-surface);
    font-weight: 800;
  }
</style>
