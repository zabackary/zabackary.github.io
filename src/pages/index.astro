---
import { getCollection } from "astro:content";
import Blob from "../components/Blob.astro";
import Card from "../components/Card.astro";
import HeroCard from "../components/HeroCard.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import Layout from "../layouts/Layout.astro";

// Newest first; undated projects go last
const recent = (await getCollection("projects"))
  .sort((a, b) =>
    (b.data.endDate ?? b.data.startDate ?? "").localeCompare(
      a.data.endDate ?? a.data.startDate ?? "",
    ),
  )
  .slice(0, 3);
---

<Layout title="about zabackary">
  <HeroCard tone="primary">
    <h1 class="display">
      Hi, I'm
      <br />
      zabackary.
    </h1>
    <Blob slot="aside" size="large">
      👋
    </Blob>
  </HeroCard>

  <ProjectCarousel projects={recent}>
    <Fragment slot="label">
      Recent
      <br />
      projects
    </Fragment>
  </ProjectCarousel>

  <div class="grid">
    <Card tone="secondary">
      <h2 class="headline">What I do</h2>
      <p>
        I make web apps, games and tools, mostly to scratch my own itch.
        Placeholder copy; swap in your own.
      </p>
    </Card>
    <Card tone="primary">
      <h2 class="headline">Elsewhere</h2>
      <p>
        <a href="https://github.com/zabackary">GitHub</a>
      </p>
    </Card>
  </div>
</Layout>

<style>
  .grid {
    margin-top: 1rem;
  }
</style>
