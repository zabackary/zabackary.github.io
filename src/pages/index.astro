---
import { getCollection } from "astro:content";
import Blob from "../components/Blob.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import HeroCard from "../components/HeroCard.astro";
import ProjectCarousel from "../components/ProjectCarousel.astro";
import Layout from "../layouts/Layout.astro";

// Newest first; undated projects go last
const recent = (await getCollection("projects"))
  .sort((a, b) => (b.data.endDate ?? b.data.startDate ?? "").localeCompare(a.data.endDate ?? a.data.startDate ?? ""))
  .slice(0, 3);
---

<Layout title="about zabackary">
  <HeroCard tone="tertiary">
    <h1 class="display">
      Hi, I'm
      <br />
      zabackary.
    </h1>
    <Blob slot="aside" size="large">
      👋
    </Blob>
  </HeroCard>

  <div class="grid">
    <Card tone="secondary">
      <h2 class="headline">What I do</h2>
      <p>
        I make web apps, games and tools, mostly to scratch my own itch.
        Placeholder copy; swap in your own.
      </p>
    </Card>
    <Card tone="primary">
      <h2 class="headline">Elsewhere</h2>
      <p>
        <a href="https://github.com/zabackary">GitHub</a>
      </p>
    </Card>
  </div>

  <h2 class="headline">Recent projects</h2>
  <ProjectCarousel projects={recent} />
  <div class="more">
    <Button href="/projects" variant="tonal">More projects</Button>
  </div>
</Layout>

<style>
  .grid {
    margin-top: 1rem;
  }
  .more {
    margin-top: 1rem;
  }
</style>
