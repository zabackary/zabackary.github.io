---
import { getCollection } from "astro:content";
import Blob from "../components/Blob.astro";
import Button from "../components/Button.astro";
import HeroCard from "../components/HeroCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection("projects");
---

<Layout title="zabackary — projects">
  <HeroCard tone="primary">
    <p class="label">Portfolio</p>
    <h1 class="display">Things I<br />have built.</h1>
    <p class="intro">Small apps, games and experiments, some finished, plenty not.</p>
    <Button href="/about">About me</Button>
    <Blob slot="aside" size="large">✦</Blob>
  </HeroCard>

  <h2 class="headline">Projects</h2>
  <div class="grid">
    {projects.map((project) => <ProjectCard {project} />)}
  </div>
</Layout>

<style>
  .intro {
    max-width: 30rem;
  }
  .headline {
    margin-top: 3rem;
  }
</style>
