---
import { getCollection, render } from "astro:content";
import Blob from "../../components/Blob.astro";
import Button from "../../components/Button.astro";
import ChipList from "../../components/ChipList.astro";
import HeroCard from "../../components/HeroCard.astro";
import Layout from "../../layouts/Layout.astro";
import { themeCss } from "../../theme";
import { projectTransitions } from "../../transitions";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { name, description, status, tags, glyph, color, link } = project.data;
const { Content } = await render(project);
const names = projectTransitions(project.id);
---

<Layout title={`${name} — zabackary`} theme={color && themeCss(color)}>
  <HeroCard transitionName={names.container}>
    <p class="label">{status}</p>
    <h1 class="display">{name}</h1>
    <p class="description">{description}</p>
    <ChipList items={tags} />
    <Blob slot="aside" size="large" transitionName={names.blob}>{glyph}</Blob>
  </HeroCard>

  <article class="prose"><Content /></article>

  <div class="actions">
    <Button href="/" variant="tonal" data-back>← All projects</Button>
    {link && <Button href={link}>View project</Button>}
  </div>
</Layout>

<script>
  // Without JS this is a plain link to "/". With JS, go back when we arrived from this site,
  // so the history stack (and the reverse view transition) behaves like a real back.
  document.querySelector<HTMLAnchorElement>("[data-back]")?.addEventListener("click", (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
    if (!document.referrer || new URL(document.referrer).origin !== location.origin) return;
    event.preventDefault();
    history.back();
  });
</script>

<style>
  .display {
    font-size: clamp(2.5rem, 9vw, 5.5rem);
  }
  .description {
    max-width: 32rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
